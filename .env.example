# Public site URL — used for canonical links, Open Graph, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.sunsetcounselingcenter.com

# Staff dashboard database (MongoDB Atlas or any MongoDB 6+)
# Inquiries are saved here and listed at /admin.
MONGODB_URI=
MONGODB_DB=sunset_counseling

# New-inquiry alert — configure ONE option.
# With MONGODB_URI set, the alert contains only a dashboard link (no personal details).
# Without a database, the full inquiry is sent instead.

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
# Who receives alerts — any address; separate several with commas.
CONTACT_TO_EMAIL=Darredo@sunsetcounselingcenterpllc.net
# Sender — must be on the domain you verified in Resend (the mailbox doesn't need to exist).
CONTACT_FROM_EMAIL="Sunset Counseling Center Website <website@sunsetcounselingcenterpllc.net>"

# Option B: POST JSON to a form service or CRM webhook
CONTACT_WEBHOOK_URL=
